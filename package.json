{
  "name": "persona-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "biome check .",
    "check:unsafe": "biome check --write --unsafe .",
    "check:write": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate-custom": "bun run src/server/db/migrate.ts",
    "db:migrations:check": "bash scripts/validate-migrations.sh",
    "db:backup": "bash scripts/backup-database.sh",
    "db:backup:verify": "bash scripts/verify-database-backup.sh",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run src/server/db/seed-demo-data.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbo",
    "directus:brand": "bash scripts/configure-directus-branding.sh",
    "directus:token:repair": "bun run scripts/repair-directus-static-token.ts",
    "i18n:check": "bun run scripts/check-i18n-catalogs.ts",
    "ops:install": "bash scripts/install-operations.sh",
    "olx:extension:package": "bash scripts/package-olx-connector.sh",
    "preview": "next build && next start",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "telegram:resume:drain": "bun run scripts/drain-telegram-resumes.ts",
    "telegram:resume:history": "bun run scripts/import-telegram-desktop-resumes.ts",
    "telegram:resume:setup": "bun run scripts/setup-telegram-resume-ingestion.ts",
    "telegram:resume:status": "bun run scripts/telegram-resume-webhook.ts status",
    "telegram:resume:webhook:set": "bun run scripts/telegram-resume-webhook.ts set",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
