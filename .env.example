# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""

# Database (shared between Drizzle and Directus)
DB_PORT=54322
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

MAIL_LOGIN=""
MAIL_LOGIN_PASSWORD=""

# Mastra / Google Gemini (use either key, GOOGLE_GENERATIVE_AI_API_KEY is preferred)
GOOGLE_GENERATIVE_AI_API_KEY=""

# Absolute or relative (to project root) path for candidate resume files.
# Example: "./storage"
RESUME_STORAGE_PATH="./storage"

# Directus Storage
DIRECTUS_URL=""
DIRECTUS_TOKEN=""
DIRECTUS_FOLDER=""

# Directus Docker
DIRECTUS_SECRET=""
DIRECTUS_ADMIN_EMAIL=""
DIRECTUS_ADMIN_PASSWORD=""

# Monitoring / alerts
MONITOR_HEALTHCHECK_URL="http://127.0.0.1:3000/api/health"
MONITOR_DISK_PATH="/"
MONITOR_CPU_THRESHOLD_PERCENT="85"
MONITOR_MEMORY_THRESHOLD_PERCENT="90"
MONITOR_DISK_THRESHOLD_PERCENT="85"
MONITOR_REQUEST_SPIKE_THRESHOLD="300"
MONITOR_REQUEST_SPIKE_WINDOW_MINUTES="5"
MONITOR_AUTH_FAILURE_THRESHOLD="10"
MONITOR_AUTH_FAILURE_WINDOW_MINUTES="15"
MONITOR_ALERT_COOLDOWN_MINUTES="30"
MONITOR_STATE_FILE="./storage/monitor/alert-state.json"
ALERT_CHANNELS="email"

# Email alerts. If omitted, the monitor falls back to MAIL_LOGIN/MAIL_LOGIN_PASSWORD on Yandex SMTP.
ALERT_SMTP_HOST=""
ALERT_SMTP_PORT="465"
ALERT_SMTP_SECURE="true"
ALERT_SMTP_USER=""
ALERT_SMTP_PASS=""
ALERT_EMAIL_FROM=""
ALERT_EMAIL_TO=""

# Telegram alerts
ALERT_TELEGRAM_BOT_TOKEN=""
ALERT_TELEGRAM_CHAT_ID=""

# SMS alerts via Twilio
ALERT_TWILIO_ACCOUNT_SID=""
ALERT_TWILIO_AUTH_TOKEN=""
ALERT_TWILIO_FROM=""
ALERT_SMS_TO=""
