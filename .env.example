# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""
# Public application origin used by NextAuth when deployed, for example:
# AUTH_URL="https://admin.talanty.uz"
AUTH_URL=""

# Database (shared between Drizzle and Directus)
DB_PORT=54322
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

MAIL_LOGIN=""
MAIL_LOGIN_PASSWORD=""

# Local development only: register and sign in without the emailed 6-digit code.
# Ignored unless NODE_ENV=development, so it cannot weaken a deployed environment.
SKIP_EMAIL_VERIFICATION="false"

# Mastra / Google Gemini (use either key, GOOGLE_GENERATIVE_AI_API_KEY is preferred)
GOOGLE_GENERATIVE_AI_API_KEY=""

# Google OAuth for NextAuth. Configure the same origins in Google Cloud:
# Authorized JavaScript origins:
#   http://localhost:3000
#   https://admin.talanty.uz
# Authorized redirect URIs (the callback path is required):
#   http://localhost:3000/api/auth/callback/google
#   https://admin.talanty.uz/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Absolute or relative (to project root) path for candidate resume files.
# Example: "./storage"
RESUME_STORAGE_PATH="./storage"

# Directus Storage
DIRECTUS_URL=""
DIRECTUS_TOKEN=""
DIRECTUS_FOLDER=""

# Directus Docker
DIRECTUS_SECRET=""
DIRECTUS_ADMIN_EMAIL=""
DIRECTUS_ADMIN_PASSWORD=""
VERCEL_URL=""

# Telegram vacancy publishing + webhook-based candidate resume ingestion
TELEGRAM_BOT_TOKEN=""
# Numeric id of the group that receives candidate resume PDFs.
TELEGRAM_RESUME_CHAT_ID=""
# Tenant that owns candidates created from the Telegram group.
TELEGRAM_RESUME_COMPANY_ID=""
# Vacancy that receives every candidate created from this group.
TELEGRAM_RESUME_VACANCY_ID=""
# Public HTTPS origin hosting this Next.js application. Used when registering
# /api/integrations/telegram/resume-webhook with Telegram.
TELEGRAM_WEBHOOK_BASE_URL=""
# Optional override. By default a webhook secret is derived from AUTH_SECRET.
TELEGRAM_WEBHOOK_SECRET=""

# OLX authenticated requests use a short-lived local Chrome/Chromium process.
# Common macOS/Linux executable paths are detected automatically. Set this only
# when the browser is installed elsewhere. Keep the sandbox enabled unless the
# application runs in a separately hardened root/container deployment.
OLX_BROWSER_EXECUTABLE_PATH=""
OLX_BROWSER_NO_SANDBOX="false"
# Optional exact extension-id override for local/unpacked builds. The official
# Chrome Web Store extension id is accepted by default.
OLX_CONNECTOR_EXTENSION_ID="fojllciekjkejbnehccfkeoghpjippon"
# Dedicated OLX credential key (32+ random characters). Previous comma-separated
# keys remain decrypt-only during rotation; remove them after all sessions rotate.
OLX_CREDENTIALS_ENCRYPTION_KEY=""
OLX_CREDENTIALS_PREVIOUS_ENCRYPTION_KEYS=""
# Optional override for the built-in Talanty OLX connector Web Store URL.
NEXT_PUBLIC_OLX_CONNECTOR_URL=""
