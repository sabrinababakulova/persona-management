{
  "manifest_version": 3,
  "name": "Talanty — olx.uz Connector",
  "version": "0.1.6",
  "description": "Connects an olx.uz account to Talanty after the user signs in on the official olx.uz website.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["scripting", "storage", "tabs", "webRequest"],
  "host_permissions": ["https://www.olx.uz/*", "https://admin.talanty.uz/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Talanty — olx.uz Connector"
  },
  "content_scripts": [
    {
      "matches": ["https://admin.talanty.uz/*"],
      "js": ["persona-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.olx.uz/*"],
      "js": ["olx-content.js"],
      "run_at": "document_idle"
    }
  ]
}
