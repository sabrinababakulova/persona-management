{
  "manifest_version": 3,
  "name": "Talanty — olx.uz Connector",
  "version": "0.1.7",
  "description": "Подключает аккаунт olx.uz к Talanty после входа пользователя на официальном сайте olx.uz.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["scripting", "storage", "tabs", "webRequest"],
  "host_permissions": [
    "https://*.olx.uz/*",
    "https://*.talanty.uz/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Talanty — olx.uz Connector"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.talanty.uz/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["persona-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.olx.uz/*"],
      "js": ["olx-content.js"],
      "run_at": "document_idle"
    }
  ]
}
